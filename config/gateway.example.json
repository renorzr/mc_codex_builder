            "app-server",
            "--listen",
            "stdio://"
        ],
        "requestTimeoutMs": 30000,
        "turnTimeoutMs": 180000,
        "permissions": {
            "localFiles": false,
            "network": false
        },
        "reasoningEffort": "medium"
    }
}
