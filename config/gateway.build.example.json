{
    "host": "127.0.0.1",
    "port": 25600,
    "backend": "codex",
    "dataDir": ".local",
    "world": {
        "enabled": true,
        "mcpServerPath": "/absolute/path/to/mcpfabric/mcp-server/dist/index.js"
    },
    "building": {
        "enabled": true,
        "maxBlocks": 2048,
        "maxDistance": 32,
        "allowOverwrite": false,
        "approvalTimeoutMs": 0,
        "blockedCommands": [
            "op",
            "deop",
            "ban",
            "ban-ip",
            "pardon",
            "pardon-ip",
            "kick",
            "whitelist",
            "stop",
            "save-off",
            "save-on",
            "reload",
            "function",
            "datapack",
            "execute",
            "schedule"
        ]
    },
    "codex": {
        "command": "codex",
        "args": [
            "app-server",
            "--listen",
            "stdio://"
        ],
        "requestTimeoutMs": 30000,
        "turnTimeoutMs": 900000,
        "permissions": {
            "localFiles": false,
            "network": false
        },
        "reasoningEffort": "medium"
    }
}
